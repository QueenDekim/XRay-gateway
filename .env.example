# Copy to .env and set addresses for your own network.
COMPOSE_PROJECT_NAME=xray-gateway
LAN_DRIVER=macvlan
LAN_PARENT=eth0
LAN_SUBNET=192.168.50.0/24
LAN_GATEWAY=192.168.50.1
GATEWAY_IP=192.168.50.20
DOCKER_HOST_IP=192.168.50.10
DEFAULT_CLIENT_CIDR=192.168.50.0/24
LOCAL_NETWORKS=192.168.50.0/24
ROUTER_LAN_INTERFACE=bridge
PANEL_PORT=8080
HEALTH_PORT=18080
ADMIN_USERNAME=admin
PROBE_URL=https://www.gstatic.com/generate_204
CHECK_INTERVAL=10
FAIL_THRESHOLD=3
RECOVER_THRESHOLD=2
XRAY_IMAGE=ghcr.io/xtls/xray-core:26.10.21
# Optional, used with compose.proxy.yaml.
PROXY_NETWORK=reverse-proxy
